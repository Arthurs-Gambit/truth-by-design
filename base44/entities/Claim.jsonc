{
  "name": "Claim",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "description": "The factual claim submitted for analysis"
    },
    "source": {
      "type": "string",
      "description": "Optional source URL or citation for the claim"
    },
    "context": {
      "type": "string",
      "description": "Optional context or notes about where the claim appeared"
    },
    "category": {
      "type": "string",
      "enum": [
        "politics",
        "science",
        "health",
        "economics",
        "history",
        "technology",
        "social",
        "other"
      ],
      "default": "other",
      "description": "Topic category of the claim"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Processing lifecycle state"
    },
    "final_verdict": {
      "type": "string",
      "enum": [
        "true",
        "mostly_true",
        "half_true",
        "mostly_false",
        "false",
        "pants_on_fire"
      ],
      "description": "Consensus verdict from the primary MoE strategy"
    },
    "consensus_confidence": {
      "type": "number",
      "description": "Confidence score (0-1) of the primary consensus result"
    }
  },
  "required": [
    "text"
  ]
}